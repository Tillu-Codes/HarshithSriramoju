# not portable and are not part of the shipped site. Their OUTPUT belongs in
# assets/, their generators stay local.
tools/create-content-visibility-gif.mjs
tools/render-content-visibility-gif.py

# Original assets being replaced - kept locally as a safety net, never publish
_backup_originals/

