# Scratch workspaces - probing harnesses, frame dumps, diagnostics.
# _work/ was the portrait rebuild (1.5 GB of frame dumps);
# _tmp/ is the current one (asset probes, screenshots, verification runs).
_work/
_tmp/

# Transient headless-browser harness pages dropped at the repo root while
# probing index.html - these reference _tmp/ and must never be committed.
_probe.html

# Screenshots taken by tools/*.ps1 and by headless-Chrome verification runs.
# These are diagnostics, not site content - never commit them.
tools/render*.png
tools/preview.png
*.render.png

# Optimisation scratch: half-encoded media, so a failed or interrupted
# ffmpeg run can never be mistaken for a finished asset in assets/.
*.part
*.tmp.mp4
*.tmp.gif

# Original assets being replaced - kept locally as a safety net, never publish
_backup_originals/

# Python bytecode from the probing/asset tooling
__pycache__/
*.py[cod]

# Node dependency tree (tools/ runs on Node built-ins only; this is a guard
# in case anything is ever npm-installed locally)
node_modules/
package-lock.json

# Deploy / hosting metadata - belongs to the host, not the repo
.vercel/
.netlify/
.firebase/
.DS_Store.local
CNAME

# OS junk
Thumbs.db
Desktop.ini
.DS_Store

# Editor / IDE scratch
*~
*.swp
*.swo
.idea/
.vscode/
.claude/
